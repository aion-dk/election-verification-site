{
  "name": "election-verification-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:docker": "vite --force --host",
    "build": "yarn type-check && yarn build-only",
    "preview": "vite preview",
    "test:unit": "vitest --config ../vite.config.ts --environment jsdom --root src/",
    "test:unit:ci": "vitest --config ../vite.config.ts --environment jsdom --root src/ --passWithNoTests --reporter dot --reporter junit --outputFile test-results/vitest.xml",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ci": "playwright test --output test-results/artifacts",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "prettier:ci": "npx prettier -c ./",
    "prettier": "npx prettier -w ./",
    "lint": "eslint src --fix",
    "lint:ci": "eslint src"
  },
  "dependencies": {
    "@assemblyvoting/electa-ui": "^6.1.2",
    "@assemblyvoting/js-client": "^7.1.3",
    "@assemblyvoting/types": "^1.3.3",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.21.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jsdom": "^31.0.1",
    "pdf-lib": "^1.17.1",
    "pinia": "^4.1.0",
    "sass": "^1.108.2",
    "sinon": "^22.1.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.65.1",
    "@rushstack/eslint-patch": "^1.10.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.13",
    "npm": ">=11.20"
  },
  "vite": {
    "optimizeDeps": {
      "include": [
        "axios"
      ]
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
